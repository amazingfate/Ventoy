 		return EFI_BUFFER_TOO_SMALL;
 	}
@@ -360,7 +360,11 @@ FileReadDir(EFI_GRUB_FILE *File, UINTN *Len, VOID *Data)
 	}
 
 	if (EFI_ERROR(Status)) {
