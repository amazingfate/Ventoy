+    grub_uint32_t img_end_sector;   // included
+
+    grub_uint64_t disk_start_sector; // in disk_sector_size
+    grub_uint64_t disk_end_sector;   // included
+}ventoy_img_chunk;
+
+
+typedef struct ventoy_override_chunk
