+static initrd_info * ventoy_find_initrd_by_name(initrd_info *list, const char *name)
+{
+    initrd_info *node = list;
+
+    while (node)
+    {
+        if (grub_strcmp(node->name, name) == 0)
+        {
+            return node;
+        }
+        node = node->next;
+    }
+
+    return NULL;
+}
