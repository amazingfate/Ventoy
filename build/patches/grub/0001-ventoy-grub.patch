+#define BROWSER_MENU_BUF    65536
+
+static const char *g_vtoy_dev = NULL;
+static grub_fs_t g_menu_fs = NULL;
+static char *g_menu_device = NULL;
+static grub_device_t g_menu_dev = NULL;
