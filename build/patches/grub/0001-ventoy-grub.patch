+char * ventoy_get_line(char *start)
+{
+    if (start == NULL)
+    {
+        return NULL;
+    }
+
+    while (*start && *start != '\n')
+    {
+        start++;
+    }
+
+    if (*start == 0)
+    {
+        return NULL;
+    }
+    else
+    {
+        *start = 0;
+        return start + 1;
+    }
+}
