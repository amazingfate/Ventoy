+    pwd = ventoy_plugin_get_password(args[0]);
+    if (pwd)
+    {
+        if (0 == ventoy_check_password(pwd, 1))
+        {
+            ret = 1;
+        }
+        else
+        {
+            ret = 0;
+        }
+    }
+    else
+    {
+        ret = 1;
+    }
+
+    grub_errno = 0;
+    return ret;
+}
