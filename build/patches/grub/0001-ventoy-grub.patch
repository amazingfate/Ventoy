+static wim_patch *ventoy_find_wim_patch(const char *path)
+{
+    int len = (int)grub_strlen(path);
+    wim_patch *node = g_wim_patch_head;
+
+    while (node)
+    {
+        if (len == node->pathlen && 0 == grub_strcmp(path, node->path))
+        {
+            return node;
+        }
+        node = node->next;
+    }
+
