+    for (node = g_image_list_head; node; node = node->next, index++)
+    {
+        if (vtoy_class_directory == type)
+        {
+            if (len < node->pathlen && ventoy_strncmp(node->isopath, name, len) == 0)
+            {
+                return index;
+            }
+        }
+        else
+        {
+            if (len == node->pathlen && ventoy_strncmp(node->isopath, name, len) == 0)
+            {
+                return index;
+            }
+        }
+    }
+
+    return 0;
+}
