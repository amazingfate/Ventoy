+static grub_err_t ventoy_cmd_img_sector(grub_extcmd_context_t ctxt, int argc, char **args)
+{
+    int rc;
+    int fs_type;
+    grub_file_t file;
+    grub_disk_addr_t start;
+    char errmsg[128];
+
+    (void)ctxt;
