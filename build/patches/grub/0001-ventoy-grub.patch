+
+    if (!g_conf_replace_head)
+    {
+        return 0;
+    }
+
+    len = (int)grub_strlen(iso);
+
+    for (node = g_conf_replace_head; node; node = node->next)
+    {
+        if (node->pathlen == len && ventoy_strncmp(node->isopath, iso, len) == 0)
+        {
+            nodes[n++] = node;
+            if (n >= VTOY_MAX_CONF_REPLACE)
