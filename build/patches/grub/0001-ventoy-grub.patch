+
+    grub_uint32_t override_chunk_offset;
+    grub_uint32_t override_chunk_num;
+
+    grub_uint32_t virt_chunk_offset;
+    grub_uint32_t virt_chunk_num;
+}ventoy_chain_head;
+
+typedef struct ventoy_image_desc
