+static grub_err_t
+grub_cmd_unset_boot_opt (grub_command_t cmd __attribute__ ((unused)),
+			 int argc __attribute__ ((unused)),
+			 char *argv[] __attribute__ ((unused)))
+{
+  int i;
+
+  for (i = 0; i < LINUX_MAX_ARGC; i++)
+    {
+      if (ventoy_linux_args[i])
