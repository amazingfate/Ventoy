+  {
+	  __asm__(
+			  "dli  $8, 0x900000003ff01000\n\t"
+			  "dli  $11, 0      \n\t"
+			  "dsll $11, 8      \n\t"
+			  "or   $8, $8,$11  \n\t"
+			  "li   $9, 0x5a5a \n\t"
+			  "sw   $9, 32($8) \n\t"
+			  "nop             \n\t"
+			  :
+			  :
+			 );
+  }
+  grub_loader_set (grub_linux_boot, grub_linux_unload, 0);
+  initrd_loaded = 0;
+  loaded = 1;
+  grub_dl_ref (my_mod);
+
+  return GRUB_ERR_NONE;
+}
