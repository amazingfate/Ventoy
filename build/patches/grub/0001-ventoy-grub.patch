+  for (i = 0; i < ventoy_extra_initrd_num; i++)
+    {
+      if (ventoy_extra_initrd_list[i])
+	grub_free (ventoy_extra_initrd_list[i]);
+    }
+  grub_memset (ventoy_extra_initrd_list, 0, sizeof (ventoy_extra_initrd_list));
+  return 0;
+}
