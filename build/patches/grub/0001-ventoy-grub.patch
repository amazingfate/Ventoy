+    dev = grub_device_open(device_name);
+    if (!dev)
+    {
+        debug("grub_device_open failed, %s\n", device_name);
+        goto end;
+    }
+
+    grub_partition_iterate(dev->disk, ventoy_img_partition_callback, &cnt);
