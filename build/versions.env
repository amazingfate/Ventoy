# Upstream pins for the source-based build.
# GRUB 2.14 (2026-01-14) is the first stable release with loongarch64-efi.
# EDK2 stable202608 is the current stable tag and includes LoongArch64.
GRUB_VERSION=2.14
GRUB_URL=https://ftp.gnu.org/gnu/grub/grub-2.14.tar.xz
EDK2_TAG=edk2-stable202608
EDK2_URL=https://github.com/tianocore/edk2.git
# One upstream tree per tool. Every architecture is a cross compile of that tree.
BUSYBOX_VERSION=1.36.1
BUSYBOX_URL=https://busybox.net/downloads/busybox-1.36.1.tar.bz2
ZSTD_VERSION=1.5.6
ZSTD_URL=https://github.com/facebook/zstd/releases/download/v1.5.6/zstd-1.5.6.tar.gz
ZLIB_VERSION=1.3.1
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz
FUSE_VERSION=2.9.9
FUSE_URL=https://github.com/libfuse/libfuse/releases/download/fuse-2.9.9/fuse-2.9.9.tar.gz
LVM2_VERSION=2_03_22
LVM2_URL=https://github.com/lvmteam/lvm2/archive/refs/tags/v2_03_22.tar.gz
EFIFS_TAG=v1.13
EFIFS_URL=https://github.com/pbatard/efifs.git
# xz-embedded v2024-12-30 adds the ARM64 and RISC-V BCJ decoders.
# Upstream still has no LoongArch BCJ filter.
XZ_EMBEDDED_VERSION=2024-12-30
XZ_EMBEDDED_URL=https://github.com/tukaani-project/xz-embedded/archive/refs/tags/v2024-12-30.tar.gz
# unsquashfs and the libraries it links. Versions match the trees Ventoy used to vendor.
SQUASHFS_VERSION=4.4
SQUASHFS_URL=https://github.com/plougher/squashfs-tools/archive/refs/tags/4.4.tar.gz
LZ4_VERSION=1.8.1.2
LZ4_URL=https://github.com/lz4/lz4/archive/refs/tags/v1.8.1.2.tar.gz
LZO_VERSION=2.08
LZO_URL=https://www.oberhumer.com/opensource/lzo/download/lzo-2.08.tar.gz
XZ_VERSION=5.2.5
XZ_URL=https://tukaani.org/xz/xz-5.2.5.tar.gz
ZSTD_LIB_VERSION=1.4.4
ZSTD_LIB_URL=https://github.com/facebook/zstd/releases/download/v1.4.4/zstd-1.4.4.tar.gz
LUNZIP_VERSION=1.11
LUNZIP_URL=https://download.savannah.gnu.org/releases/lzip/lunzip/lunzip-1.11.tar.gz
SMALLZ4_VERSION=1.4
SMALLZ4_URL=https://github.com/stbrumme/smallz4/archive/refs/tags/smallz4_v1.4.tar.gz
VBLADE_VERSION=24
VBLADE_URL=https://github.com/OpenAoE/vblade/archive/refs/tags/vblade-24.tar.gz
EXFAT_VERSION=1.3.0
EXFAT_URL=https://github.com/relan/exfat/archive/refs/tags/v1.3.0.zip
IPXE_COMMIT=3fe683ebab29afacf224e6b0921f6329bebcdca7
IPXE_URL=https://github.com/ipxe/ipxe/archive/3fe683ebab29afacf224e6b0921f6329bebcdca7.tar.gz
LIBHTTP_VERSION=1.8
LIBHTTP_URL=https://github.com/lammertb/libhttp/archive/refs/tags/v1.8.tar.gz
FAT_IO_COMMIT=0ef5c2bbc0ab2ff96d970a2149764d8fc377eb33
FAT_IO_URL=https://github.com/ultraembedded/fat_io_lib/archive/0ef5c2bbc0ab2ff96d970a2149764d8fc377eb33.tar.gz
# Porteus Kiosk 5.5.0 userspace follows the Gentoo portage snapshot tagged
# 20230318 and ships ntfs3g-2022.10.3. The ISO contains the FUSE driver only.
# This is the upstream tarball named by that Gentoo ebuild.
KIOSK_NTFS3G_VERSION=2022.10.3
KIOSK_NTFS3G_URL=https://download.tuxera.com/opensource/ntfs-3g_ntfsprogs-2022.10.3.tgz
# LiveCD fallback fonts. Kiosk 001-core already has DejaVu Sans/Serif.
# These Regular faces cover the scripts DejaVu does not: Han, kana, hangul,
# Thai, Devanagari, Bengali, Tamil, and Malayalam.
NOTO_CJK_VERSION=Sans2.004
NOTO_SC_URL=https://github.com/notofonts/noto-cjk/releases/download/Sans2.004/18_NotoSansSC.zip
NOTO_TC_URL=https://github.com/notofonts/noto-cjk/releases/download/Sans2.004/19_NotoSansTC.zip
NOTO_JP_URL=https://github.com/notofonts/noto-cjk/releases/download/Sans2.004/16_NotoSansJP.zip
NOTO_KR_URL=https://github.com/notofonts/noto-cjk/releases/download/Sans2.004/17_NotoSansKR.zip
NOTO_THAI_VERSION=2.002
NOTO_THAI_URL=https://github.com/notofonts/thai/releases/download/NotoSansThai-v2.002/NotoSansThai-v2.002.zip
NOTO_DEVA_VERSION=2.007
NOTO_DEVA_URL=https://github.com/notofonts/devanagari/releases/download/NotoSansDevanagari-v2.007/NotoSansDevanagari-v2.007.zip
NOTO_BENG_VERSION=3.011
NOTO_BENG_URL=https://github.com/notofonts/bengali/releases/download/NotoSansBengali-v3.011/NotoSansBengali-v3.011.zip
NOTO_TAML_VERSION=2.004
NOTO_TAML_URL=https://github.com/notofonts/tamil/releases/download/NotoSansTamil-v2.004/NotoSansTamil-v2.004.zip
NOTO_MLYM_VERSION=2.104
